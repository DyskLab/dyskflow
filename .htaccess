# For hosting where the document root cannot point at /public.
# Everything is served from /public, so app code, .env and vendor stay unreachable.
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Drop a trailing slash before the rewrite into public/. Left to public/.htaccess, some servers
    # (LiteSpeed) would send the visitor to /public/... instead.
    RewriteCond %{DOCUMENT_ROOT}/public/$1 !-d
    RewriteRule ^(.+)/$ /$1 [L,R=301]

    RewriteRule ^public/ - [L]
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

<IfModule !mod_rewrite.c>
    Require all denied
</IfModule>

    },
    {
      "key": "text",
      "type": "textarea",
      "label": "Text",
      "translatable": true
    },
    {
      "key": "button_label",
      "type": "text",
      "label": "Button label",
      "translatable": true
    },
    {
      "key": "url",
      "type": "url",
      "label": "Button link",
      "translatable": true
    },
    {
      "key": "button2_label",
      "type": "text",
      "label": "Second button label",
      "translatable": true
    },
    {
      "key": "url2",
      "type": "url",
      "label": "Second button link",
      "translatable": true
    },
    {
      "key": "ribbon",
      "type": "text",
      "label": "Ribbon",
      "translatable": true,

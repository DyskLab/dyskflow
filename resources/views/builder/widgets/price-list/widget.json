{
  "label": "Price list",
  "icon": "list",
  "group": "content",
  "description": "Items with their price, such as a menu or a list of services.",
  "fields": [
    {
      "key": "items",
      "type": "repeater",
      "label": "Items",
      "min_items": 1,
      "max_items": 40,
      "fields": [
        {
          "key": "title",
          "type": "text",
          "label": "Name",
          "translatable": true,
          "required": true
        },
        {
          "key": "price",
          "type": "text",
          "label": "Price",
          "translatable": true
        },
        {
          "key": "description",
          "type": "textarea",
          "label": "Description",
          "translatable": true
        },
        {
          "key": "image",
          "type": "image",
          "label": "Image"
        },
        {
          "key": "url",
          "type": "url",
          "label": "Link",
          "translatable": true
        }
      ]
    },
    {
      "key": "leader",
      "type": "toggle",
      "label": "Dotted line between name and price",
      "default": true
    },
    {
      "key": "columns",
      "type": "select",
      "label": "Columns",
      "options": [
        "1",
        "2"
      ],
      "default": "1",
      "responsive": true
    }
  ]
}

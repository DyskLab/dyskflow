          "id": "ct046",
          "widgets": [
            {
              "id": "wt045",
              "type": "stats",
              "columns": "3",
              "items": [
                {
                  "value": "10+",
                  "label": {
                    "id": "Tahun pengalaman",
                    "en": "Years of experience"
                  }
                },
                {
                  "value": "1.200+",
                  "label": {
                    "id": "Proyek selesai",
                    "en": "Projects done"
                  }
                },
                {
                  "value": "98%",
                  "label": {
                    "id": "Pelanggan puas",
                    "en": "Happy customers"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "st051",
      "type": "section",
      "style": {
        "text": "center"
      },
      "columns": [
        {
          "id": "ct050",
          "widgets": [
            {
              "id": "wt048",
              "type": "heading",
              "text": {
                "id": "Kata pelanggan",
                "en": "What customers say"
              }
            },
            {
              "id": "wt049",
              "type": "testimonials",
              "margin": "md",
              "columns": {
                "base": "2",
                "mobile": "1"
              },
              "items": [
                {
                  "quote": {
                    "id": "Rapi, cepat, dan komunikatif.",
                    "en": "Neat, fast and easy to talk to."
                  },
                  "name": "Budi",
                  "role": "Jakarta"
                },
                {
                  "quote": {
                    "id": "Harga sesuai penawaran, tidak ada biaya tersembunyi.",
                    "en": "The price matched the quote, no hidden costs."
                  },
                  "name": "Dewi",
                  "role": "Bandung"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "st058",
      "type": "section",
      "anchor": "kontak",
      "style": {
        "background": "muted"
      },
      "columns": [
        {
          "id": "ct054",
          "width": {
            "base": 7,
            "tablet": 12
          },
          "widgets": [
            {
              "id": "wt052",
              "type": "heading",
              "text": {
                "id": "Hubungi kami",
                "en": "Contact us"
              }
            },
            {
              "id": "wt053",
              "type": "contact",
              "layout": "cards"
            }
          ]
        },
        {
          "id": "ct057",
          "width": {
            "base": 5,
            "tablet": 12
          },
          "widgets": [
            {
              "id": "wt055",
              "type": "heading",
              "size": "md",
              "text": {
                "id": "Pertanyaan umum",
                "en": "Frequently asked questions"
              }
            },
            {
              "id": "wt056",
              "type": "faq",
              "items": [
                {
                  "question": {
                    "id": "Berapa lama pengerjaannya?",
                    "en": "How long does it take?"
                  },
                  "answer": {
                    "id": "Tergantung pekerjaan; kami beri jadwal di penawaran.",
                    "en": "It depends on the job; the quote includes a schedule."
                  }
                },
                {
                  "question": {
                    "id": "Apakah melayani luar kota?",
                    "en": "Do you work outside the city?"
                  },
                  "answer": {
                    "id": "Ya, dengan biaya transport sesuai jarak.",
                    "en": "Yes, with a travel fee based on distance."
                  }
                }
              ]
            }
          ]
        }
      ]

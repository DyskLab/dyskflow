                  "text": {
                    "id": "Penawaran tertulis sebelum mulai.",
                    "en": "A written quote before we start."
                  }
                },
                {
                  "title": {
                    "id": "Bergaransi",
                    "en": "Guaranteed"
                  },
                  "text": {
                    "id": "Kami perbaiki tanpa biaya bila ada masalah.",
                    "en": "We fix any problem at no cost."
                  }
                }
              ]
            }
          ]
        }
      ]
    },
